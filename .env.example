# COGNEXA environment reference.
#
# Copy to .env (local development) or .env.production (deployment) and
# fill in values. Both are gitignored -- never commit real secrets.
# Full explanations: docs/DEPLOYMENT.md.

# --------------------------------------------------------------- core
# development (python app.py) | production (wsgi.py, Docker) | testing
APP_ENV=development

# Signs session cookies, CSRF tokens and remember-me cookies.
# Production: REQUIRED, at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Development: may be left empty (a key is generated into instance/).
SECRET_KEY=

# Public origin used in password-reset and verification email links.
# Production: REQUIRED, must start with https://
APP_BASE_URL=http://127.0.0.1:5000

# Development server only (python app.py). Never used in production.
FLASK_DEBUG=1

LOG_LEVEL=INFO

# ----------------------------------------------------------- database
# Empty = SQLite at gaminghub/database/gaming.db (development).
# Production: REQUIRED. PostgreSQL recommended:
#   postgresql://user:password@host:5432/cognexa
# (postgres:// and postgresql:// are both accepted.) A SQLite file on a
# persistent volume also works for a single instance:
#   sqlite:////data/cognexa.db
DATABASE_URL=

# --------------------------------------------------------- web/proxy
# Number of reverse proxies (load balancer, Nginx, platform router) in
# front of the app whose X-Forwarded-* headers should be trusted.
TRUSTED_PROXY_COUNT=0

# Send cookies over HTTPS only. Defaults to 1 in production, 0 otherwise.
# SESSION_COOKIE_SECURE=1

REMEMBER_COOKIE_DAYS=14

# Waitress worker threads per process (Docker/Procfile).
# WAITRESS_THREADS=8

# -------------------------------------------------------- rate limits
# memory:// is per-process. Production with more than one process or
# instance: REQUIRED shared storage, e.g. redis://host:6379/0
RATELIMIT_STORAGE_URI=memory://
# Production single-process deployments may opt in to memory storage:
RATELIMIT_ALLOW_MEMORY_STORAGE=0
# Keep limiting per process if Redis becomes unreachable (recommended).
RATELIMIT_IN_MEMORY_FALLBACK_ENABLED=1

# -------------------------------------------------------------- email
# console (development: messages go to the log), smtp (production),
# disabled (send nothing; email changes and verification unavailable).
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=COGNEXA <no-reply@localhost>
MAIL_TIMEOUT=10

# --------------------------------------------------- account security
# 1 = accounts must verify their email before logging in or getting an
# API token. 0 = unverified accounts can sign in and are prompted to
# verify (accounts created before verification existed keep working).
EMAIL_VERIFICATION_REQUIRED=0
EMAIL_VERIFICATION_TOKEN_MAX_AGE=172800
PASSWORD_RESET_TOKEN_MAX_AGE=3600
API_TOKEN_TTL_DAYS=30

# ------------------------------------------- docker-compose.yml only
POSTGRES_USER=cognexa
POSTGRES_PASSWORD=
POSTGRES_DB=cognexa
WEB_PORT=8000
