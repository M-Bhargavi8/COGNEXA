# Copy this file to .env and fill in real values for production.
# Neither this file nor .env.* is loaded with real secrets in this repo --
# .env itself is gitignored, so it's safe to keep actual values there.

# Signs session cookies and CSRF tokens. If unset, a random key is
# generated once and persisted to instance/secret_key for local dev.
# Always set this explicitly in production.
SECRET_KEY=

# Set to 0 to disable Flask's debug mode (interactive debugger, auto-
# reload). Defaults to 1 (on) if unset -- always set this to 0 outside
# local development; the debugger allows arbitrary code execution.
FLASK_DEBUG=1
